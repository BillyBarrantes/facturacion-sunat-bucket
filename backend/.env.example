# =============================================
# FACTURACION-SUNAT — Configuracion de Entorno
# =============================================
# Copia este archivo como .env y completa los valores.
# NUNCA commites .env con credenciales reales.

# --- Modo desarrollo ---
# DEV_MODE=true desactiva verificacion JWT y permite fallbacks.
# Solo para desarrollo local. En produccion, DEV_MODE=false (default).
DEV_MODE=false

# --- Supabase (obligatorio en produccion) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# JWT Secret de Supabase (Settings > API > JWT Settings)
SUPABASE_JWT_SECRET=

# --- Gemini AI (opcional en dev, obligatorio en prod) ---
GEMINI_API_KEY=

# --- R2 / Cloudflare (almacenamiento de XML, PDF, CDR) ---
R2_BUCKET_NAME=facturacion-sunat-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://tu-cuenta.r2.cloudflarestorage.com

# --- Entorno SUNAT ---
# BETA: pruebas, permite certificado autofirmado
# PRODUCCION: exige certificado digital real (CDT)
SUNAT_ENV=BETA
