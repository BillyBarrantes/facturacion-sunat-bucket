# =============================================
# FACTURACION-SUNAT — Configuration de Entorno
# =============================================
# Copia este archivo como .env y completa los valores.
# NUNCA commites .env con credenciales reales.

# --- Supabase (obligatorio en todos los entornos) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_JWT_SECRET=

# --- Gemini AI (opcional en dev, obligatorio con OCR) ---
GEMINI_API_KEY=

# --- R2 / Cloudflare (almacenamiento de XML, PDF, CDR) ---
R2_BUCKET_NAME=facturacion-sunat-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://tu-cuenta.r2.cloudflarestorage.com

# --- Entorno SUNAT ---
# BETA: permite certificado autofirmado (pruebas)
# PRODUCCION: exige certificado digital real (CDT)
SUNAT_ENV=BETA

# --- CORS (dominios permitidos, separados por comas) ---
# En produccion: https://facturasunat.vercel.app
# Local: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory